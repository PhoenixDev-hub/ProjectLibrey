# Segredo JWT — OBRIGATÓRIO, mínimo 32 bytes aleatórios (ex: openssl rand -hex 32)
JWT_SECRET=

# URL do banco (obrigatória)
DATABASE_URL=postgresql://postgres:SUA_SENHA_URL_ENCODED@localhost:5432/project_library

# Número de hops de proxy entre o client e o Express.
# 1 = um proxy (nginx, ALB, Caddy) — default.
# 0 = sem proxy (app exposta direto).
# >1 = cadeia de proxies (CDN -> WAF -> proxy).
TRUST_PROXY_HOPS=1

# CORS — origens permitidas (allowlist), separadas por vírgula.
# Requisições com Origin fora da lista recebem 403.
CORS_ORIGIN=http://localhost:5173,https://app.librey.com

PORT=3333
NODE_ENV=development

# Nível de log do Winston (debug | info | warn | error). Default: info
LOG_LEVEL=info

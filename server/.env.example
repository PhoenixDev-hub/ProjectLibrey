# Server environment example
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://postgres:SUBSTITUA_PELA_SENHA_URL_ENCODED@localhost:5432/project_library

# Docker Compose: executar na raiz com --env-file server/.env
DB_USER=postgres
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL_FORTE
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE

# Frontend URL used to build reset link
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (leave empty in development to use Ethereal)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
